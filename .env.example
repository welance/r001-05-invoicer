CLOCKIFY_API_KEY=your_clockify_api_key
CLOCKIFY_WORKSPACE_ID=your_workspace_id

# Qonto Business API — one credential pair per legal entity (org).
# `invoicer.yaml`'s `orgs:` block references these by env-var name, so
# the actual secrets live here in .env and only the names get checked in.
# Example: if you have an Italian SRL and a German GmbH, add both.
QONTO_LOGIN_SRL=your-srl-org-slug
QONTO_SECRET_KEY_SRL=your_srl_qonto_secret_key
QONTO_LOGIN_GMBH=your-gmbh-org-slug
QONTO_SECRET_KEY_GMBH=your_gmbh_qonto_secret_key
#
# Legacy single-org mode (pre-0.4.0): if your invoicer.yaml has NO `orgs:`
# block, set `QONTO_LOGIN` / `QONTO_SECRET_KEY` directly and the tool falls
# back to them. New installs should use the per-org shape above; `invoicer
# init` walks you through it.
# QONTO_LOGIN=your-org-slug
# QONTO_SECRET_KEY=your_qonto_secret_key

# Optional: only needed for LLM-assisted steps (`client add`, `defaults set --ai`)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gmail API (OAuth2) — used by `invoicer mail-draft` to create Gmail drafts.
#
# ⚠️  IMPORTANT: Gmail is the ONLY service here that needs more than env vars.
# You also need a `credentials.json` file in the repo root. Get it via:
#
#   1. https://console.cloud.google.com/projectcreate       → create a project
#   2. https://console.cloud.google.com/apis/library/gmail.googleapis.com  → Enable
#   3. https://console.cloud.google.com/apis/credentials/consent  → Internal user type
#   4. https://console.cloud.google.com/apis/credentials   → Create OAuth client ID
#      → Desktop app → Download JSON → save as `credentials.json` in the repo root
#
# On first run, `invoicer mail-draft` opens a browser for consent and writes
# `token.json` (also gitignored). Subsequent runs are silent. Gmail is USER-
# BASED: the mailbox that authenticates owns the drafts, regardless of what
# `GMAIL_SENDER` says. Either share one mailbox between orgs (recommended)
# or re-auth per org by deleting `token.json`.
#
# Or just run `invoicer init` — it walks you through all of the above.
GMAIL_SENDER=you@yourdomain.com
# Display name used in the email signature. Defaults to the local-part of GMAIL_SENDER.
GMAIL_SENDER_NAME=Your Name
