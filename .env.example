CLOCKIFY_API_KEY=your_clockify_api_key
CLOCKIFY_WORKSPACE_ID=your_workspace_id
QONTO_LOGIN=your-org-slug
QONTO_SECRET_KEY=your_qonto_secret_key

# Optional: only needed for LLM-assisted steps (client extraction, error explanation)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gmail API (OAuth2) — used by `invoicer mail-draft` to create Gmail drafts.
#
# ⚠️  IMPORTANT: Gmail is the ONLY service here that needs more than env vars.
# You also need a `credentials.json` file in the repo root. Get it via:
#
#   1. https://console.cloud.google.com/projectcreate       → create a project
#   2. https://console.cloud.google.com/apis/library/gmail.googleapis.com  → Enable
#   3. https://console.cloud.google.com/apis/credentials/consent  → Internal user type
#   4. https://console.cloud.google.com/apis/credentials   → Create OAuth client ID
#      → Desktop app → Download JSON → save as `credentials.json` in the repo root
#
# On first run, `invoicer mail-draft` opens a browser for consent and writes
# `token.json` (also gitignored). Subsequent runs are silent.
#
# Or just run `invoicer init` — it walks you through all of the above.
GMAIL_SENDER=you@yourdomain.com
# Display name used in the email signature. Defaults to the local-part of GMAIL_SENDER.
GMAIL_SENDER_NAME=Your Name
